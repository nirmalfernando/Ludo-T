<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs include filter for LUDO-T.
  All standard bug categories are enabled. Add <Match> blocks below
  to suppress specific false positives when needed.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
                        https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- Include all bugs in production source -->
    <Match>
        <Package name="~com\.ludot.*"/>
    </Match>

</FindBugsFilter>
